#!/bin/sh
# 部署 OAF/NSS 纯按钮版：RPC 后端 + LuCI2 视图 + 菜单
set -e

SD=$(dirname "$0")

# 1) RPC 执行体
mkdir -p /usr/libexec/rpcd
cp -f "$SD/../usr/libexec/rpcd/luci.oaf_nss" /usr/libexec/rpcd/luci.oaf_nss
chmod 755 /usr/libexec/rpcd/luci.oaf_nss

# 2) LuCI2 视图与菜单
mkdir -p /usr/share/luci/resources/views/system
cp -f "$SD/../usr/share/luci/resources/views/system/oaf-nss-toggle.js" \
      /usr/share/luci/resources/views/system/oaf-nss-toggle.js
cp -f "$SD/../usr/share/luci/menu.d/luci-app-oaf-nss-toggle.json" \
      /usr/share/luci/menu.d/luci-app-oaf-nss-toggle.json

# 3) 去掉上一版 xterm 入口（若残留），避免菜单重复
rm -rf /tmp/luci-*

# 4) 重载 rpcd（让新 object 生效）+ uhttpd
/etc/init.d/rpcd restart 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true

logger -t oaf-nss-luci "纯按钮版已注册：服务 -> OAF / NSS 切换"

rm -f "$0"
exit 0
