#!/bin/sh
# /etc/uci-defaults/92-oaf-nss-guard
# 安装 oaf-nss-guard 并注册为每分钟 cron 任务，防止 NSS 在 OAF 启用期间被偷起
set -e
SELF=/etc/uci-defaults/92-oaf-nss-guard

chmod +x /usr/sbin/oaf-nss-guard

# 避免重复注册
(crontab -l 2>/dev/null | grep -v "oaf-nss-guard"; echo "*/1 * * * * /usr/sbin/oaf-nss-guard") \
	| crontab - 2>/dev/null || true

rm -f "$SELF"
exit 0
